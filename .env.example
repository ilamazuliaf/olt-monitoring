# ==========================================
# TELEGRAM BOT CONFIGURATION
# ==========================================
TELEGRAM_BOT_TOKEN=123456789:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Telegram user/chat ID yang diperbolehkan (pisahkan dengan koma jika lebih dari satu)
TELEGRAM_ALLOWED_CHAT_IDS=123456789,987654321


# ==========================================
# OLT TARGET CONFIGURATION
# ==========================================
OLT_NAME=OLT-UTAMA
OLT_HOST=192.168.88.2
OLT_PORT=161

# Versi SNMP: 1, 2c, atau 3
OLT_SNMP_VERSION=2c

# Community String untuk SNMP v1/v2c (Read-Only)
OLT_SNMP_COMMUNITY=public


# ==========================================
# SNMP TIMEOUT & RETRIES
# ==========================================
SNMP_TIMEOUT=5
SNMP_RETRIES=2


# ==========================================
# OPTICAL POWER & THRESHOLD
# ==========================================
# Threshold RX Power dalam dBm (contoh: -25 artinya <= -25 dBm dianggap redaman tinggi/buruk)
OLT_RX_POWER_THRESHOLD=-25

# Pembagi / Scale faktor nilai mentah SNMP ke dBm.
# Contoh 100 (HSGQ OLT): nilai mentah SNMP -2958 / 100 = -29.58 dBm
# Contoh 10 (ZTE/Fiberhome): nilai mentah SNMP -253 / 10 = -25.3 dBm
# Contoh 1 (jika nilai SNMP dari OLT sudah langsung berformat desimal float dBm)
OLT_RX_POWER_SCALE=100


# ==========================================
# OID CONFIGURATION (Sesuaikan dengan MIB OLT)
# ==========================================
# Contoh OID untuk HSGQ OLT Private MIB (50224):
# OID_ONT_STATUS=1.3.6.1.4.1.50224.3.3.2.1.8
# OID_ONT_RX_POWER=1.3.6.1.4.1.50224.3.3.3.1.4
# OID_ONT_TX_POWER=1.3.6.1.4.1.50224.3.3.3.1.5
# OID_ONT_VENDOR=1.3.6.1.4.1.50224.3.3.2.1.25
# OID_ONT_MODEL=1.3.6.1.4.1.50224.3.3.2.1.26
# OID_ONT_NAME=1.3.6.1.4.1.50224.3.3.2.1.2

# OID Status ONT (Wajib)
OID_ONT_STATUS=1.3.6.1.4.1.50224.3.3.2.1.8

# OID RX Optical Power (Opsional)
OID_ONT_RX_POWER=1.3.6.1.4.1.50224.3.3.3.1.4

# OID TX Optical Power (Opsional)
OID_ONT_TX_POWER=1.3.6.1.4.1.50224.3.3.3.1.5

# OID Vendor ONT (Opsional - gabungan Vendor + Model akan ditampilkan sebagai Model pada pesan Telegram)
OID_ONT_VENDOR=1.3.6.1.4.1.50224.3.3.2.1.25

# OID Model ONT (Opsional)
OID_ONT_MODEL=1.3.6.1.4.1.50224.3.3.2.1.26

# OID Serial Number ONT (Opsional - gunakan jika tidak menggunakan Vendor + Model)
OID_ONT_SERIAL=

# OID Nama / Deskripsi ONT (Opsional)
OID_ONT_NAME=1.3.6.1.4.1.50224.3.3.2.1.2


# ==========================================
# STATUS VALUE MAPPING
# ==========================================
# Nilai integer / string dari SNMP yang menyatakan ONT ONLINE
ONT_STATUS_ONLINE_VALUES=1,up,working

# Nilai integer / string dari SNMP yang menyatakan ONT OFFLINE
ONT_STATUS_OFFLINE_VALUES=2,3,4,down,off,los,dyingGasp


# ==========================================
# LOGGING
# ==========================================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
